# Copy this file to .env and fill in your real Supabase connection string.
# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Take the value Supabase gives you (starts with postgres://) and change the
# scheme to postgresql+psycopg2:// as shown below.

SUPABASE_DB_URL=postgresql+psycopg2://postgres:<YOUR_PASSWORD>@db.<YOUR_PROJECT_REF>.supabase.co:5432/postgres

# Where the source CSV/JSONL files live (defaults to <project_root>/data)
DATA_DIR=./data
