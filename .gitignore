# ==========================================
# Python / FastAPI
# ==========================================

# Virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Python packaging
*.egg-info/
*.egg
dist/
build/
.eggs/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# Jupyter
.ipynb_checkpoints/

# ==========================================
# FastAPI / Backend environment variables
# ==========================================

.env
.env.*
!.env.example

# ==========================================
# Node / React / Vite
# ==========================================

# Dependencies
node_modules/

# Production builds
frontend/dist/
frontend/build/

# Vite cache
frontend/.vite/

# Environment variables
frontend/.env
frontend/.env.*
!frontend/.env.example

